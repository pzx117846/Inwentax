@model Inwentax.Models.Ticket

@{
    ViewData["Title"] = "Szczegóły zgłoszenia";
    var usersList = ViewData["UsersList"] as List<Inwentax.Models.UserViewModel> ?? new List<Inwentax.Models.UserViewModel>();
}

<div>
    <h4>Szczegóły zgłoszenia</h4>
    <hr />
    <dl class="row">
        @if (User.IsInRole("Admin"))
        {
            <dt class="col-sm-2 fw-bold">Pracownik</dt>
            <dd class="col-sm-10">
                @{
                    var userMatch = usersList.FirstOrDefault(u => u.Id == Model.UserId);
                }
                @if (userMatch != null)
                {
                    <span>@userMatch.Name @userMatch.Surname</span>
                }
                else
                {
                    <span>Brak użytkownika</span>
                }
            </dd>
        }
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Type)
        </dt>
        <dd class="col-sm-10">
            @if (Model.Type == "damage")
            {
                <span>Awaria</span>
            }
            else if (Model.Type == "swap")
            {
                <span>Wymiana</span>
            }
            else
            {
                @Html.DisplayFor(model => model.Type)
            }
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Created)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Created)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @if (Model.Status == "new")
            {
                <span>Nowe</span>
            }
            else if (Model.Status == "in_progress")
            {
                <span>W trakcie realizacji</span>
            }
            else if (Model.Status == "done")
            {
                <span>Zakończone</span>
            }
        </dd>
    </dl>
</div>
<div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id">Edytuj</a> @:|
    }
    <a asp-action="Index">Powrót do listy</a>
</div>
