@model Inwentax.Models.Ticket

@{
    ViewData["Title"] = "Dodaj zgłoszenie";
}

<h4>Dodaj nowe zgłoszenie</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Type" class="control-label fw-bold"></label>
                <select asp-for="Type" class="form-select">
                    <option value="damage">Awaria</option>
                    <option value="swap">Wymiana</option>
                </select>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>
            <div class="form-group mb-4">
                <label asp-for="Description" class="control-label fw-bold"></label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary fw-bold">Dodaj zgłoszenie</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Anuluj</a>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Powrót do listy</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
