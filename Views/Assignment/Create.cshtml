@model Inwentax.Models.Assignment

@{
    ViewData["Title"] = "Wydanie sprzętu";
}

<h4>Wydanie sprzętu pracownikowi</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="UserId" class="control-label"></label>
                <select asp-for="UserId" class="form-control" asp-items="ViewBag.UserId"></select>
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LaptopId" class="control-label"></label>
                <select asp-for="LaptopId" class ="form-control" asp-items="ViewBag.LaptopId">
                    <option value=""> </option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="PhoneId" class="control-label"></label>
                <select asp-for="PhoneId" class ="form-control" asp-items="ViewBag.PhoneId">
                    <option value=""> </option>
                </select>
            </div>
            <div class="form-group">
                <input type="submit" value="Wydaj sprzęt" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Powrót do listy</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
