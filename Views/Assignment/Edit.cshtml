@model Inwentax.Models.Assignment

@{
    ViewData["Title"] = "Edycja wpisu";
}

<h4>Historia sprzętowa</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Status" />
            <div class="form-group mb-3">
                <label asp-for="UserId" class="control-label"></label>
                <select asp-for="UserId" class="form-control" asp-items="ViewBag.UserId"></select>
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LaptopId" class="control-label"></label>
                <select asp-for="LaptopId" class="form-control" asp-items="ViewBag.LaptopId"></select>
                <span asp-validation-for="LaptopId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PhoneId" class="control-label"></label>
                <select asp-for="PhoneId" class="form-control" asp-items="ViewBag.PhoneId"></select>
                <span asp-validation-for="PhoneId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="date_from" class="control-label"></label>
                <input asp-for="date_from" class="form-control" />
                <span asp-validation-for="date_from" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="date_to" class="control-label"></label>
                <input asp-for="date_to" class="form-control" />
                <span asp-validation-for="date_to" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Zapisz" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Powrót do listy</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
