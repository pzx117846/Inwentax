@{
    ViewData["Title"] = "Panel Główny Pracownika";
}

<div class="text-center mt-5 mb-5">
    <h1 class="display-4 fw-bold text-primary">Twój Panel Inwentax</h1>
    <p class="text-muted fs-5">Zarządzaj swoim sprzętem firmowym</p>
</div>

<div class="row g-4 justify-content-center">
    
    <div class="col-md-4">
        <div class="card h-100 shadow border-0 rounded-4">
            <div class="card-body p-4 text-center d-flex flex-column justify-content-between">
                <div>
                    <h4 class="card-title fw-bold fs-3 mb-3">Mój Sprzęt</h4>
                </div>
                    <a asp-controller="Assignment" asp-action="Index" class="btn btn-primary w-100 fw-bold">Zobacz sprzęt</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow border-0 rounded-4">
            <div class="card-body p-4 text-center d-flex flex-column justify-content-between">
                <div>
                    <h4 class="card-title fw-bold fs-3 mb-3">Zgłoszenia i Wnioski</h4>
                </div>
                    <a asp-controller="Ticket" asp-action="Index" class="btn btn-danger w-100 fw-bold">Przejdź do zgłoszeń</a>
            </div>
        </div>
    </div>
</div>